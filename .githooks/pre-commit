#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ] && [ "${ALLOW_MAIN_COMMIT:-}" != "1" ]; then
    echo "direct commits on main are blocked; use a task branch (or set ALLOW_MAIN_COMMIT=1 for an intentional maintenance commit)" >&2
    exit 1
fi
