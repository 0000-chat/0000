{
  "name": "@0000-chat/0000",
  "version": "0.1.11",
  "description": "Local ACP bridge for connecting external coding agents to 0000 Chat.",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "bridge": "bun scripts/acp-bridge.ts",
    "bridge:connect": "bun scripts/acp-bridge.ts connect",
    "bridge:dev": "bun scripts/bridge-dev-supervisor.ts",
    "bridge:smoke-cloud": "bun scripts/acp-bridge/cloud-smoke.ts",
    "bridge:smoke-runtimes": "bun scripts/acp-bridge/runtime-smoke.ts",
    "bridge:start": "bun scripts/acp-bridge.ts start",
    "bridge:update": "bun scripts/bridge-updater.ts",
    "sbom": "bun scripts/generate-sbom.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "observability:check": "bun scripts/observability-check.ts",
    "quality": "bun test && bun run typecheck && bun run observability:check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.25.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "bun-types": "^1.3.14",
    "typescript": "~6.0.2"
  }
}
