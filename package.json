{
  "name": "0000",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/check-workspace.mjs && bun scripts/check-topology.mjs && bun run check:licenses",
    "check:topology": "bun scripts/check-topology.mjs && bun scripts/check-topology-fixtures.mjs",
    "check:licenses": "bun scripts/check-licenses.mjs",
    "check:turbo": "turbo run check",
    "check:turbo:dry": "turbo run check --dry=json"
  },
  "devDependencies": {
    "turbo": "2.10.13"
  }
}
