{
  "name": "0000",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/check-workspace.mjs && node scripts/release/check-config.mjs",
    "check:turbo": "turbo run check",
    "check:turbo:dry": "turbo run check --dry=json",
    "test:release": "node --test scripts/release/release.test.mjs",
    "release:event": "node scripts/release/event.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.13"
  }
}
