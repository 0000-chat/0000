#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/0000-scaffold/npm"
mkdir -p "$cache_dir"
cd "$root"

if [ "$#" -eq 0 ]; then
    set -- .
fi

exec npx --yes --prefer-offline --cache "$cache_dir" --package "oxlint@1.82.0" -- oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern "$@"
