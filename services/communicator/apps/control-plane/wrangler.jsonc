{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "communicator-control-plane",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/1 * * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/internal/*",
      "/auth/*",
      "/oauth/*",
      "/.well-known/*",
      "/mcp"
    ]
  },
  "exports": {
    "TenantProjectionDO": { "type": "durable-object", "storage": "sqlite" },
    "LinkSessionDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      { "name": "TENANT_PROJECTION", "class_name": "TenantProjectionDO" },
      { "name": "LINK_SESSIONS", "class_name": "LinkSessionDO" }
    ]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "communicator-control-directory-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "CONTROL_DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVENT_ARCHIVE",
      "bucket_name": "communicator-event-archive-local"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "communicator-ingestion-local"
      }
    ],
    "consumers": [
      {
        "queue": "communicator-ingestion-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
        "max_concurrency": 5,
        "dead_letter_queue": "communicator-ingestion-dlq-local"
      }
    ]
  },
  "vars": {
    "COMMUNICATOR_ENV": "development",
    "COMMUNICATOR_DATA_MODE": "simulated",
    "COMMUNICATOR_PLATFORM_BASE_URL": "http://localhost:8787",
    "COMMUNICATOR_PLATFORM_AUTHORITY": "platform-t01-authority",
    "COMMUNICATOR_PLATFORM_AUDIENCE": "https://communicator.local.invalid",
    "COMMUNICATOR_PLATFORM_BROWSER_CLIENT_ID": "communicator-control-plane",
    "COMMUNICATOR_PLATFORM_BROWSER_REDIRECT_URI": "https://communicator.local.invalid/auth/callback",
    "COMMUNICATOR_PLATFORM_BROWSER_RESOURCE": "https://communicator.local.invalid",
    "COMMUNICATOR_PLATFORM_BROWSER_SCOPES": "conversation.read conversation.create group.create group.manage message.send message.mutate receipt.send connection.read connection.manage export.create replay.run retention.manage break_glass.inspect directory.read directory.manage directory.request webhook.manage",
    "COMMUNICATOR_INGRESS_ENABLED": "false",
    "CONNECTION_GATEWAY_URL": "https://matrix-gateway.internal.example.invalid"
  },
  "env": {
    "staging": {
      "name": "communicator-control-plane-staging",
      "triggers": { "crons": ["*/1 * * * *"] },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "communicator-control-directory-staging",
          "database_id": "bbf24536-eb91-4425-a4ee-c8f8c90e1ade",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "COMMUNICATOR_ENV": "staging",
        "COMMUNICATOR_DATA_MODE": "simulated",
        "COMMUNICATOR_PLATFORM_BASE_URL": "https://platform.0000.chat",
        "COMMUNICATOR_PLATFORM_AUTHORITY": "platform-t01-authority",
        "COMMUNICATOR_PLATFORM_AUDIENCE": "https://communicator-staging.0000.chat",
        "COMMUNICATOR_PLATFORM_BROWSER_CLIENT_ID": "communicator-staging",
        "COMMUNICATOR_PLATFORM_BROWSER_REDIRECT_URI": "https://communicator-staging.0000.chat/auth/callback",
        "COMMUNICATOR_PLATFORM_BROWSER_RESOURCE": "https://communicator-staging.0000.chat",
        "COMMUNICATOR_PLATFORM_BROWSER_SCOPES": "conversation.read conversation.create group.create group.manage message.send message.mutate receipt.send connection.read connection.manage export.create replay.run retention.manage break_glass.inspect directory.read directory.manage directory.request webhook.manage",
        "COMMUNICATOR_INGRESS_ENABLED": "false",
        "CONNECTION_GATEWAY_URL": "https://matrix-gateway.internal.example.invalid"
      },
      "durable_objects": {
        "bindings": [
          { "name": "TENANT_PROJECTION", "class_name": "TenantProjectionDO" },
          { "name": "LINK_SESSIONS", "class_name": "LinkSessionDO" }
        ]
      },
      "r2_buckets": [
        {
          "binding": "EVENT_ARCHIVE",
          "bucket_name": "communicator-event-archive-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INGESTION_QUEUE",
            "queue": "communicator-ingestion-staging"
          }
        ],
        "consumers": [
          {
            "queue": "communicator-ingestion-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
            "max_concurrency": 5,
            "dead_letter_queue": "communicator-ingestion-dlq-staging"
          }
        ]
      }
    },
    "production": {
      "name": "communicator-control-plane-production",
      "triggers": { "crons": ["*/1 * * * *"] },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "communicator-control-directory-production",
          "database_id": "78815235-c67b-4409-bb0d-832f66ec21d7",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "COMMUNICATOR_ENV": "production",
        "COMMUNICATOR_DATA_MODE": "live",
        "COMMUNICATOR_PLATFORM_BASE_URL": "https://platform.0000.chat",
        "COMMUNICATOR_PLATFORM_AUTHORITY": "platform-t01-authority",
        "COMMUNICATOR_PLATFORM_AUDIENCE": "https://communicator.0000.chat",
        "COMMUNICATOR_PLATFORM_BROWSER_CLIENT_ID": "communicator-production",
        "COMMUNICATOR_PLATFORM_BROWSER_REDIRECT_URI": "https://communicator.0000.chat/auth/callback",
        "COMMUNICATOR_PLATFORM_BROWSER_RESOURCE": "https://communicator.0000.chat",
        "COMMUNICATOR_PLATFORM_BROWSER_SCOPES": "conversation.read conversation.create group.create group.manage message.send message.mutate receipt.send connection.read connection.manage export.create replay.run retention.manage break_glass.inspect directory.read directory.manage directory.request webhook.manage",
        "COMMUNICATOR_INGRESS_ENABLED": "false",
        "CONNECTION_GATEWAY_URL": "https://matrix-gateway.internal.example.invalid"
      },
      "durable_objects": {
        "bindings": [
          { "name": "TENANT_PROJECTION", "class_name": "TenantProjectionDO" },
          { "name": "LINK_SESSIONS", "class_name": "LinkSessionDO" }
        ]
      },
      "r2_buckets": [
        {
          "binding": "EVENT_ARCHIVE",
          "bucket_name": "communicator-event-archive-production"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INGESTION_QUEUE",
            "queue": "communicator-ingestion-production"
          }
        ],
        "consumers": [
          {
            "queue": "communicator-ingestion-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
            "max_concurrency": 5,
            "dead_letter_queue": "communicator-ingestion-dlq-production"
          }
        ]
      }
    }
  }
}
