#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/0000-scaffold/npm"
mkdir -p "$cache_dir"
cd "$root"

npx --workspaces=false --yes --prefer-offline --cache "$cache_dir" --package "oxlint@1.82.0" -- oxlint --version
npx --workspaces=false --yes --prefer-offline --cache "$cache_dir" --package "@biomejs/biome@2.5.13" -- biome --version
