#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tool_cache="$root/.cache/bun"
mkdir -p "$tool_cache"
cd "$root"

if [ "$#" -eq 0 ]; then
    set -- .
fi

exec env BUN_INSTALL="$tool_cache" bunx --package "oxlint@1.82.0" oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern "$@"
