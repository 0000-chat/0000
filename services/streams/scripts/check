#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
python3 - "$root" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
repository_root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], cwd=root, text=True).strip())
service_path = root.relative_to(repository_root).as_posix()
expected = {
    ".github/workflows/quality.yml",
    ".githooks/pre-commit",
    ".gitignore",
    ".gitkeep",
    ".oxlintrc.json",
    "0000-product.json",
    "AGENTS.md",
    "README.md",
    "biome.json",
    "docs/README.md",
    "docs/agents/domain.md",
    "docs/agents/issue-tracker.md",
    "docs/agents/triage-labels.md",
    "docs/migration/2026-09-17-monorepo-import.md",
    "docs/migration/codex-task-mapping.json",
    "package.json",
    "scripts/check",
    "scripts/format",
    "scripts/format-check",
    "scripts/install-tools",
    "scripts/lint",
    "src/auth.ts",
    "src/bundle.test.ts",
    "src/domain.test.ts",
    "src/domain.ts",
    "src/mcp.test.ts",
    "src/mcp.ts",
    "src/room.test.ts",
    "src/room.ts",
    "src/surface.test.ts",
    "src/ui.ts",
    "src/worker-configuration.d.ts",
    "src/worker.test.ts",
    "src/worker.ts",
    "tsconfig.json",
    "wrangler.jsonc",
}
tracked = {
    Path(path).relative_to(service_path).as_posix()
    for path in subprocess.check_output(
        ["git", "ls-files", "--", service_path], cwd=repository_root, text=True
    ).splitlines()
    if (repository_root / path).is_file()
}
# Include expected files added in the current worktree before they are staged.
tracked.update(path for path in expected if (root / path).is_file())
missing = expected - tracked
if missing:
    raise SystemExit(f"service files missing: {sorted(missing)}")
metadata = json.loads((root / "0000-product.json").read_text(encoding="utf-8"))
if metadata.get("schema_version") != 1 or metadata.get("name") != "0000-streams":
    raise SystemExit("invalid product metadata")
if metadata.get("dependencies") != ["0000-database"]:
    raise SystemExit("streams must require 0000-database")
if metadata.get("status") != "active-development" or metadata.get("application_code") is not True:
    raise SystemExit("product must reflect the imported application code")
if metadata.get("license_selected") is not False:
    raise SystemExit("service must not select a license")
readme = " ".join((root / "README.md").read_text(encoding="utf-8").split())
if "requires `0000-database`" not in readme or "A hosted 0000 account is not required" not in readme:
    raise SystemExit("README must state the streams dependency and authentication behavior")
if "Cloudflare" not in readme or "deployment has not been verified" not in readme:
    raise SystemExit("README must state hosting intent")
PY
git diff --check -- .
"$root/scripts/install-tools"
"$root/scripts/lint"
"$root/scripts/format-check"
"$root/scripts/format-check" src
bun run typecheck
bun run test
echo "0000-streams application checks passed"
