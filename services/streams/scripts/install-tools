#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

test -x "$root/node_modules/.bin/oxlint" || {
    echo "Streams tooling is not installed; run bun install --frozen-lockfile first." >&2
    exit 1
}
test -x "$root/node_modules/.bin/biome" || {
    echo "Streams tooling is not installed; run bun install --frozen-lockfile first." >&2
    exit 1
}
"$root/node_modules/.bin/oxlint" --version
"$root/node_modules/.bin/biome" --version
