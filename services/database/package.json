{
  "name": "@0000/database",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "check": "bun ../../scripts/check-workspace.mjs --workspace @0000/database",
    "check:application": "./scripts/check",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern --fix .",
    "format": "biome format --write .",
    "format:check": "biome format --no-errors-on-unmatched ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "oxlint": "1.82.0"
  }
}
