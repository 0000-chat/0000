{
  "name": "@0000/database",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "The 0000 Database Cloudflare Worker and durable SQLite pilot.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "check": "bun ../../scripts/check-workspace.mjs --workspace @0000/database",
    "check:application": "./scripts/check",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "test": "bun test test/durable.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern .",
    "lint:fix": "oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern --fix .",
    "format": "biome format --write .",
    "format:check": "biome format --no-errors-on-unmatched ."
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.3",
    "@biomejs/biome": "2.5.13",
    "@cloudflare/workers-types": "5.20260916.1",
    "miniflare": "5.20260916.0-alpha",
    "oxlint": "1.82.0",
    "typescript": "6.0.3",
    "wrangler": "4.133.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.4.3"
  }
}
