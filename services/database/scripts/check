#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
repo_root=$(git rev-parse --show-toplevel)
service_prefix=${root#"$repo_root"/}
python3 - "$root" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
required = [
    ".gitkeep",
    "0000-product.json",
    "package.json",
    "pnpm-lock.yaml",
    "src/worker.ts",
    "src/database-object.ts",
    "src/database-registry.ts",
    "wrangler.jsonc",
    "test/durable.spec.ts",
]
missing = [name for name in required if not (root / name).is_file()]
if missing:
    raise SystemExit(f"required Database service files are missing: {missing}")
metadata = json.loads((root / "0000-product.json").read_text(encoding="utf-8"))
if metadata.get("schema_version") != 1 or metadata.get("name") != "0000-database":
    raise SystemExit("invalid product metadata")
if metadata.get("license_selected") is not True:
    raise SystemExit("Database must record its selected public license")
if metadata.get("status") != "active-development" or metadata.get("application_code") is not True:
    raise SystemExit("product metadata must describe the durable pilot as active development")
readme = " ".join((root / "README.md").read_text(encoding="utf-8").split())
package = json.loads((root / "package.json").read_text(encoding="utf-8"))
if package.get("license") != "AGPL-3.0-only":
    raise SystemExit("Database package must match the selected public license")
required_readme_phrases = [
    "`0000-database` aims",
    "`0000-platform` for common identity and authentication",
    "`0000-streams` depends",
    "SQLite Durable Object",
    "Do not store sensitive information",
]
if any(phrase not in readme for phrase in required_readme_phrases):
    raise SystemExit("README must describe product relationships and the durable pilot")
PY
pnpm run lint
pnpm run format:check
pnpm run typecheck
pnpm run test
pnpm run build
git -C "$repo_root" diff --check -- "$service_prefix"
echo "0000-database service checks passed"
