{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "0000-gateway",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "gateway.0000.chat",
      "custom_domain": true
    }
  ],
  "alias": {
    "@mcp-use/client": "./src/mcp-use-client-unavailable.ts"
  }
}
