{
  "name": "0000-gateway",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "lint": "cd .. && oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern .",
    "lint:fix": "cd .. && oxlint --config .oxlintrc.json --deny-warnings --no-error-on-unmatched-pattern --fix .",
    "format": "cd .. && biome format --write .",
    "format:check": "cd .. && biome format --no-errors-on-unmatched ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "oxlint": "1.82.0"
  }
}
