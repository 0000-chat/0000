{
  "name": "@0000/msg",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "description": "The msg conversation relay Worker and its CLI.",
  "type": "module",
  "scripts": {
    "check": "bun ../../scripts/check-workspace.mjs --workspace @0000/msg && bun run check:application",
    "check:application": "bun run check:worker && bun run check:tooling && bun run check:cli",
    "check:worker": "bun run --cwd worker check:application",
    "check:tooling": "bun test scripts",
    "check:cli": "bun run --cwd cli check:application",
    "wrangler:types": "bun scripts/wrangler-config.ts types worker/worker-configuration.d.ts --include-runtime=true",
    "wrangler": "bun scripts/wrangler-config.ts",
    "operator": "bun worker/scripts/operator.ts",
    "synthetic": "bun worker/scripts/production-synthetic.ts",
    "deployment-allocation": "bun scripts/deployment-allocation.ts"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "miniflare": "^4.20260515.0",
    "oxlint": "^1.82.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.50.0",
    "ws": "8.18.0"
  }
}
