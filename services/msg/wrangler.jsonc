{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "0000-msg",
  "main": "worker/src/worker-entry.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.svg"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "msg.0000.chat",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ConversationRoom",
        "class_name": "ConversationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "MSG_DB",
      "database_name": "0000-msg-operations",
      "database_id": "__MSG_D1_DATABASE_ID__",
      "migrations_dir": "worker/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "MSG_RATE_LIMIT_CREATION",
      "namespace_id": "2026080901",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "MSG_RATE_LIMIT_READS",
      "namespace_id": "2026080902",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MSG_RATE_LIMIT_POSTS",
      "namespace_id": "2026080903",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "MSG_RATE_LIMIT_LIVE",
      "namespace_id": "2026080904",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./worker/public",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "secrets": {
    "required": ["MSG_DATA_ENCRYPTION_KEY_V1", "MSG_OPERATOR_TOKEN"]
  },
  "vars": {
    "MSG_CREATE_DISABLED": "0",
    "MSG_POST_DISABLED": "0",
    "MSG_PUBLIC_ORIGIN": "https://msg.0000.chat"
  }
}
