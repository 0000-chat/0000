#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
python3 - "$root" <<'PYTHON'
import json
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1]).resolve()
repo = Path(subprocess.check_output(
    ["git", "rev-parse", "--show-toplevel"], cwd=root, text=True
).strip()).resolve()
prefix = root.relative_to(repo).as_posix()
all_tracked = subprocess.check_output(
    ["git", "ls-files", "-z"], cwd=repo
).decode().split("\0")
if prefix == ".":
    tracked = {path for path in all_tracked if path}
else:
    marker = prefix + "/"
    tracked = {path[len(marker):] for path in all_tracked if path.startswith(marker)}

source_files = {
    ".githooks/pre-commit",
    ".github/workflows/quality.yml",
    ".gitignore",
    ".oxlintrc.json",
    "0000-product.json",
    "AGENTS.md",
    "README.md",
    "biome.json",
    "docs/README.md",
    "docs/agents/domain.md",
    "docs/agents/issue-tracker.md",
    "docs/agents/triage-labels.md",
    "scripts/check",
    "scripts/format",
    "scripts/format-check",
    "scripts/install-tools",
    "scripts/lint",
}
expected = set(source_files)
if prefix != ".":
    expected |= {
        ".gitkeep",
        "package.json",
        "docs/migration/2026-09-17-monorepo-import.md",
        "docs/migration/codex-task-mapping.json",
    }
if tracked != expected:
    raise SystemExit(
        f"tracked scaffold mismatch: missing={sorted(expected-tracked)} "
        f"extra={sorted(tracked-expected)}"
    )
metadata = json.loads((root / "0000-product.json").read_text(encoding="utf-8"))
if metadata.get("schema_version") != 1 or metadata.get("name") != "0000-platform":
    raise SystemExit("invalid product metadata")
if metadata.get("status") != "scaffold-only" or metadata.get("application_code") is not False:
    raise SystemExit("product is not marked scaffold-only")
if metadata.get("license_selected") is not True:
    raise SystemExit("Platform must record its selected public license")
readme = (root / "README.md").read_text(encoding="utf-8")
if "Standalone public" not in readme or "Cloudflare" not in readme:
    raise SystemExit("README must state standalone authentication and Cloudflare hosting intent")
PYTHON
git diff --check
echo "0000-platform scaffold checks passed"
