#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
python3 - "$root" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

root = Path(sys.argv[1])
expected = {
    ".github/workflows/quality.yml",
    ".githooks/pre-commit",
    ".gitignore",
    ".oxlintrc.json",
    "0000-product.json",
    "AGENTS.md",
    "README.md",
    "biome.json",
    "docs/README.md",
    "docs/agents/domain.md",
    "docs/agents/issue-tracker.md",
    "docs/agents/triage-labels.md",
    "scripts/check",
    "scripts/format",
    "scripts/format-check",
    "scripts/install-tools",
    "scripts/lint",
}
tracked = set(subprocess.check_output(["git", "ls-files"], text=True).splitlines())
# Include expected files added in the current worktree before they are staged.
tracked.update(path for path in expected if (root / path).is_file())
if tracked != expected:
    raise SystemExit(f"tracked scaffold mismatch: missing={sorted(expected-tracked)} extra={sorted(tracked-expected)}")
metadata = json.loads((root / "0000-product.json").read_text(encoding="utf-8"))
if metadata.get("schema_version") != 1 or metadata.get("name") != root.name:
    raise SystemExit("invalid product metadata")
if metadata.get("visibility") != "private" or metadata.get("status") != "scaffold-only":
    raise SystemExit("cloud metadata must be private and scaffold-only")
if metadata.get("deployment_implementation") is not False or metadata.get("application_code") is not False:
    raise SystemExit("cloud scaffold must not contain deployment or application implementation")
if metadata.get("license_selected") is not False:
    raise SystemExit("scaffold must not select a license")
readme = (root / "README.md").read_text(encoding="utf-8")
for phrase in ("Cloudflare", "private provider-neutral Docker host", "no public product API"):
    if phrase not in readme:
        raise SystemExit(f"README must state {phrase}")
PY
git diff --check
"$root/scripts/install-tools"
"$root/scripts/lint"
"$root/scripts/format-check"
echo "0000-cloud scaffold checks passed"
