{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0000.chat/schemas/cloudflare-worker-artifact-v1.json",
  "title": "0000 prebuilt Cloudflare Worker artifact manifest",
  "description": "Exact metadata embedded in a public, environment-neutral Worker bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "name",
    "version",
    "kind",
    "media_type",
    "source_commit",
    "compatibility",
    "entrypoint",
    "compatibility_date",
    "compatibility_flags"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "0000" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]{40}$" },
    "kind": { "const": "cloudflare-worker-bundle" },
    "media_type": { "const": "application/gzip" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "config"],
      "properties": {
        "api": { "const": "v1" },
        "config": { "const": "v1" }
      }
    },
    "entrypoint": { "const": "worker.js" },
    "compatibility_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "compatibility_flags": {
      "type": "array",
      "minItems": 1,
      "items": { "const": "nodejs_compat" }
    }
  }
}
