{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "communicator-control-plane",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/internal/*",
      "/oauth/*",
      "/.well-known/*",
      "/mcp"
    ]
  },
  "exports": {
    "TenantProjectionDO": { "type": "durable-object", "storage": "sqlite" },
    "LinkSessionDO": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      { "name": "TENANT_PROJECTION", "class_name": "TenantProjectionDO" },
      { "name": "LINK_SESSIONS", "class_name": "LinkSessionDO" }
    ]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "communicator-control-directory-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "CONTROL_DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVENT_ARCHIVE",
      "bucket_name": "communicator-event-archive-local"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "communicator-ingestion-local"
      }
    ],
    "consumers": [
      {
        "queue": "communicator-ingestion-local",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 60,
        "max_concurrency": 5,
        "dead_letter_queue": "communicator-ingestion-dlq-local"
      }
    ]
  },
  "vars": {
    "COMMUNICATOR_ENV": "development",
    "COMMUNICATOR_DATA_MODE": "simulated",
    "COMMUNICATOR_OIDC_ISSUER": "https://auth.local.invalid/",
    "COMMUNICATOR_OIDC_AUDIENCE": "communicator-api",
    "COMMUNICATOR_OIDC_JWKS_URL": "https://auth.local.invalid/.well-known/jwks.json",
    "COMMUNICATOR_ACCESS_ISSUER": "https://access.local.invalid/",
    "COMMUNICATOR_ACCESS_AUDIENCE": "access-audience.local.invalid",
    "COMMUNICATOR_ACCESS_JWKS_URL": "https://access.local.invalid/cdn-cgi/access/certs",
    "COMMUNICATOR_INGRESS_ENABLED": "false",
    "COMMUNICATOR_INGESTION_OIDC_ISSUER": "https://ingestion-auth.local.invalid/",
    "COMMUNICATOR_INGESTION_OIDC_AUDIENCE": "communicator-ingestion",
    "COMMUNICATOR_INGESTION_OIDC_JWKS_URL": "https://ingestion-auth.local.invalid/.well-known/jwks.json",
    "COMMUNICATOR_OAUTH_ISSUER": "https://communicator.local.invalid/",
    "COMMUNICATOR_OAUTH_RESOURCE": "https://communicator.local.invalid/mcp",
    "COMMUNICATOR_OAUTH_ACCESS_TOKEN_TTL_SECONDS": "900",
    "COMMUNICATOR_OAUTH_HUMAN_AUTHORIZE_URL": "https://auth.local.invalid/authorize",
    "COMMUNICATOR_OAUTH_HUMAN_CLIENT_ID": "communicator-local",
    "COMMUNICATOR_OAUTH_HUMAN_REDIRECT_URI": "https://communicator.local.invalid/oauth/callback",
    "COMMUNICATOR_OAUTH_HUMAN_SCOPE": "openid profile",
    "COMMUNICATOR_OAUTH_HUMAN_TOKEN_URL": "https://auth.local.invalid/token",
    "COMMUNICATOR_OAUTH_HUMAN_ISSUER": "https://auth.local.invalid/",
    "COMMUNICATOR_OAUTH_HUMAN_AUDIENCE": "communicator-api",
    "COMMUNICATOR_OAUTH_HUMAN_JWKS_URL": "https://auth.local.invalid/.well-known/jwks.json",
    "CONNECTION_GATEWAY_URL": "https://matrix-gateway.internal.example.invalid"
  },
  "env": {
    "staging": {
      "name": "communicator-control-plane-staging",
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "communicator-control-directory-staging",
          "database_id": "bbf24536-eb91-4425-a4ee-c8f8c90e1ade",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "COMMUNICATOR_ENV": "staging",
        "COMMUNICATOR_DATA_MODE": "simulated",
        "COMMUNICATOR_OIDC_ISSUER": "https://auth.local.invalid/",
        "COMMUNICATOR_OIDC_AUDIENCE": "communicator-api",
        "COMMUNICATOR_OIDC_JWKS_URL": "https://auth.local.invalid/.well-known/jwks.json",
        "COMMUNICATOR_ACCESS_ISSUER": "https://access.local.invalid/",
        "COMMUNICATOR_ACCESS_AUDIENCE": "access-audience.local.invalid",
        "COMMUNICATOR_ACCESS_JWKS_URL": "https://access.local.invalid/cdn-cgi/access/certs",
        "COMMUNICATOR_INGRESS_ENABLED": "false",
        "COMMUNICATOR_INGESTION_OIDC_ISSUER": "https://ingestion-auth.local.invalid/",
        "COMMUNICATOR_INGESTION_OIDC_AUDIENCE": "communicator-ingestion",
        "COMMUNICATOR_INGESTION_OIDC_JWKS_URL": "https://ingestion-auth.local.invalid/.well-known/jwks.json",
        "COMMUNICATOR_OAUTH_ISSUER": "https://communicator-staging.local.invalid/",
        "COMMUNICATOR_OAUTH_RESOURCE": "https://communicator-staging.local.invalid/mcp",
        "COMMUNICATOR_OAUTH_ACCESS_TOKEN_TTL_SECONDS": "900",
        "COMMUNICATOR_OAUTH_HUMAN_AUTHORIZE_URL": "https://auth.local.invalid/authorize",
        "COMMUNICATOR_OAUTH_HUMAN_CLIENT_ID": "communicator-staging",
        "COMMUNICATOR_OAUTH_HUMAN_REDIRECT_URI": "https://communicator-staging.local.invalid/oauth/callback",
        "COMMUNICATOR_OAUTH_HUMAN_SCOPE": "openid profile",
        "COMMUNICATOR_OAUTH_HUMAN_TOKEN_URL": "https://auth.local.invalid/token",
        "COMMUNICATOR_OAUTH_HUMAN_ISSUER": "https://auth.local.invalid/",
        "COMMUNICATOR_OAUTH_HUMAN_AUDIENCE": "communicator-api-staging",
        "COMMUNICATOR_OAUTH_HUMAN_JWKS_URL": "https://auth.local.invalid/.well-known/jwks.json",
        "CONNECTION_GATEWAY_URL": "https://matrix-gateway.internal.example.invalid"
      },
      "durable_objects": {
        "bindings": [
          { "name": "TENANT_PROJECTION", "class_name": "TenantProjectionDO" },
          { "name": "LINK_SESSIONS", "class_name": "LinkSessionDO" }
        ]
      },
      "r2_buckets": [
        {
          "binding": "EVENT_ARCHIVE",
          "bucket_name": "communicator-event-archive-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INGESTION_QUEUE",
            "queue": "communicator-ingestion-staging"
          }
        ],
        "consumers": [
          {
            "queue": "communicator-ingestion-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
            "max_concurrency": 5,
            "dead_letter_queue": "communicator-ingestion-dlq-staging"
          }
        ]
      }
    },
    "production": {
      "name": "communicator-control-plane-production",
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "communicator-control-directory-production",
          "database_id": "78815235-c67b-4409-bb0d-832f66ec21d7",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "COMMUNICATOR_ENV": "production",
        "COMMUNICATOR_DATA_MODE": "live",
        "COMMUNICATOR_OIDC_ISSUER": "https://auth.local.invalid/",
        "COMMUNICATOR_OIDC_AUDIENCE": "communicator-api",
        "COMMUNICATOR_OIDC_JWKS_URL": "https://auth.local.invalid/.well-known/jwks.json",
        "COMMUNICATOR_ACCESS_ISSUER": "https://access.local.invalid/",
        "COMMUNICATOR_ACCESS_AUDIENCE": "access-audience.local.invalid",
        "COMMUNICATOR_ACCESS_JWKS_URL": "https://access.local.invalid/cdn-cgi/access/certs",
        "COMMUNICATOR_INGRESS_ENABLED": "false",
        "COMMUNICATOR_INGESTION_OIDC_ISSUER": "https://ingestion-auth.local.invalid/",
        "COMMUNICATOR_INGESTION_OIDC_AUDIENCE": "communicator-ingestion",
        "COMMUNICATOR_INGESTION_OIDC_JWKS_URL": "https://ingestion-auth.local.invalid/.well-known/jwks.json",
        "COMMUNICATOR_OAUTH_ISSUER": "https://communicator-production.local.invalid/",
        "COMMUNICATOR_OAUTH_RESOURCE": "https://communicator-production.local.invalid/mcp",
        "COMMUNICATOR_OAUTH_ACCESS_TOKEN_TTL_SECONDS": "900",
        "COMMUNICATOR_OAUTH_HUMAN_AUTHORIZE_URL": "https://auth.local.invalid/authorize",
        "COMMUNICATOR_OAUTH_HUMAN_CLIENT_ID": "communicator-production",
        "COMMUNICATOR_OAUTH_HUMAN_REDIRECT_URI": "https://communicator-production.local.invalid/oauth/callback",
        "COMMUNICATOR_OAUTH_HUMAN_SCOPE": "openid profile",
        "COMMUNICATOR_OAUTH_HUMAN_TOKEN_URL": "https://auth.local.invalid/token",
        "COMMUNICATOR_OAUTH_HUMAN_ISSUER": "https://auth.local.invalid/",
        "COMMUNICATOR_OAUTH_HUMAN_AUDIENCE": "communicator-api-production",
        "COMMUNICATOR_OAUTH_HUMAN_JWKS_URL": "https://auth.local.invalid/.well-known/jwks.json",
        "CONNECTION_GATEWAY_URL": "https://matrix-gateway.internal.example.invalid"
      },
      "durable_objects": {
        "bindings": [
          { "name": "TENANT_PROJECTION", "class_name": "TenantProjectionDO" },
          { "name": "LINK_SESSIONS", "class_name": "LinkSessionDO" }
        ]
      },
      "r2_buckets": [
        {
          "binding": "EVENT_ARCHIVE",
          "bucket_name": "communicator-event-archive-production"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INGESTION_QUEUE",
            "queue": "communicator-ingestion-production"
          }
        ],
        "consumers": [
          {
            "queue": "communicator-ingestion-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "retry_delay": 60,
            "max_concurrency": 5,
            "dead_letter_queue": "communicator-ingestion-dlq-production"
          }
        ]
      }
    }
  }
}
